{
  "name": "specialization_at_js_scenarios",
  "type": "module",
  "description": "Automated test scenarios for specialization project using WebdriverIO and Cucumber.",
  "author": "Eliana Méndez",
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@types/node": "^25.0.6",
    "@wdio/allure-reporter": "^9.20.0",
    "@wdio/cli": "^9.20.0",
    "@wdio/cucumber-framework": "^9.20.0",
    "@wdio/local-runner": "^9.20.0",
    "@wdio/spec-reporter": "^9.20.0",
    "axios": "^1.13.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "test": "wdio run ./src/core/config/wdio.conf.ts",
    "test:smoke": "wdio run ./src/core/config/wdio.conf.ts --cucumberOpts.tagExpression='@smoke'",
    "test:register": "wdio run ./src/core/config/wdio.conf.ts --spec ./src/test/features/user_registration.feature",
    "test:login": "wdio run ./src/core/config/wdio.conf.ts --spec ./src/test/features/user_login.feature",
    "test:validLogin": "wdio run ./src/core/config/wdio.conf.ts --spec ./src/test/features/user_login.feature --cucumberOpts.tagExpression='@validLogin'",
    "test:invalidLogin": "wdio run ./src/core/config/wdio.conf.ts --spec ./src/test/features/user_login.feature --cucumberOpts.tagExpression='@invalidLogin'",
    "test:profile": "wdio run ./src/core/config/wdio.conf.ts --spec ./src/test/features/user_profile.feature",
    "test:homeProduct": "wdio run ./src/core/config/wdio.conf.ts --spec ./src/test/features/home_page.feature",
    "test:basket": "wdio run ./src/core/config/wdio.conf.ts --spec ./src/test/features/basket.feature",
    "test:checkout": "wdio run ./src/core/config/wdio.conf.ts --spec ./src/test/features/checkout.feature",
    "report": "allure generate allure-results --clean -o allure-report"
  },
  "engines": {
    "node": "18.20.3"
  },
  "dependencies": {
    "node-fetch": "^3.3.2"
  }
}
